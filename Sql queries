-- Question 4:- Calculate the daily percentage change in volume for each ticker in the prices table?
-- a)Percentage change can be calculated as (current - previous) / previous
-- b)Multiply the percentage by 100 and round the value to 2 decimal places
-- c)Return data for the first 10 days of August 2021

select * from prices;

with cte as
(select market_date,ticker,volume,
case
when volume like '%K' then volume * 1000
when volume like '%M' then volume * 1000000
else round(volume,0)
end as new_volume
from prices where market_date between '2021-08-01' and '2021-08-10'),
cte_prev as 
(select ticker,market_date,new_volume,
lag(new_volume) over(partition by ticker order by market_date) as prev_vol
from cte where new_volume != 0)
select ticker,market_date,new_volume,prev_vol,
round(100 * ((new_volume - prev_vol) / prev_vol ),2) as per_change
from cte_prev where market_date between '2021-08-01' and '2021-08-10'
order by ticker,market_date;

