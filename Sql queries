-- Question 1 - Which top 3 mentors have the most Bitcoin quantity? Return the first_name of the mentors and sort the output from highest to lowest total_quantity?

select * from members;
select * from prices;
select * from transactions;

select m.first_name,
sum(
case 
when t.txn_type = "Buy" then t.quantity
when t.txn_type = "Sell" then -t.quantity
end
) as total
from members m join transactions t 
on (m.member_id = t.member_id)
where t.ticker = 'BTC'
group by m.first_name
order by total desc limit 3;

